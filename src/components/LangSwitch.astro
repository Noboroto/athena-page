---
import { localePath, t, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  /** Target URL in the other language; defaults to the same page. */
  href?: string;
  rest?: string;
}

const { locale, href, rest = '/' } = Astro.props;
const other: Locale = locale === 'vi' ? 'en' : 'vi';
---

<a
  class="lang-switch"
  href={href ?? localePath(other, rest)}
  hreflang={other === 'vi' ? 'vi-VN' : 'en-US'}
  lang={other}
>
  {t(other, 'lang.switch')}
</a>
