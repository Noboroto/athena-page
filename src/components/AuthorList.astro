---
import { localePath, type Locale } from '../i18n';
import { authorName, type Author } from '../lib/people';

interface Props {
  authors: Author[];
  locale: Locale;
}
const { authors, locale } = Astro.props;
---

{authors.map((a, i) => (
  <>
    {'member' in a ? (
      <a href={localePath(locale, `/members/${a.member.id}/`)}>{authorName(a)}</a>
    ) : (
      <span>{a.name}</span>
    )}
    {i < authors.length - 1 && ', '}
  </>
))}
